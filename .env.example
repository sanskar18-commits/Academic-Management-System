# Academic Track - Environment Configuration Template
# Duplicate this file to .env and configure your secrets

# Database Connection (SQLite or PostgreSQL / MySQL)
# For SQLite (default zero-dependency setup):
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/academic_track?schema=public"

# JSON Web Token Secret (Change in production to a high-entropy 64+ char string)
JWT_SECRET="academic_track_super_secure_institutional_secret_key_2024"

# Controlled Demo User Passwords (Configurable, never hardcoded in frontend)
DEMO_STUDENT_PASSWORD="Student@123"
DEMO_TEACHER_PASSWORD="Teacher@123"

# Application Metadata
NEXT_PUBLIC_APP_NAME="Academic Track"
NEXT_PUBLIC_APP_TAGLINE="Your Academic Work, Organized."

# Server Port
PORT=3000

# Google Gemini AI Integration (Server-Side Only)
# Used for:
# 1. Teacher voice / instruction notes summarization
# 2. Student query priority urgency classification (HIGH / MEDIUM / LOW)
# SECURITY: Never expose to frontend (no NEXT_PUBLIC prefix).
# If omitted or invalid, the backend automatically uses safe fallbacks and custom DSA Priority Queue.
GEMINI_API_KEY=""
